{
  "name": "nexus-cluster-project-c",
  "version": "1.0.0",
  "description": "Distributed Master-Slave Task Runner",
  "main": "launcher.js",
  "bin": "launcher.js",
  "type": "commonjs",
  "scripts": {
    "start": "node launcher.js",
    "build": "pkg . --out-path ./dist"
  },
  "pkg": {
    "assets": [
      "ui/**/*",
      "master/**/*",
      "agent/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dockerode": "^4.0.10",
    "express": "^5.2.1",
    "localtunnel": "^2.0.2",
    "multer": "^2.1.1",
    "open": "^8.4.2",
    "socket.io": "^4.8.3",
    "systeminformation": "^5.31.5"
  },
  "custom_config": {
    "url": "http://localhost:4000",
    "image": "pytorch/pytorch",
    "command": [
      "python",
      "train.py"
    ],
    "gpu": true
  },
  "author": "",
  "license": "ISC"
}
